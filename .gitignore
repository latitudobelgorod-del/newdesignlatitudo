# Версионируем ТОЛЬКО свой код в /local. Всё остальное (ядро Битрикса, контент,
# upload, дампы, мусор, окружение) — вне Git.
/*
!/.gitignore
!/local
# документация и скрипт запуска — общие для всех машин, их версионируем
!/WORKFLOW.md
!/AGENTS.md
!/CLAUDE.md
!/WORKLOG-*.md
!/start-latitudo-ru.cmd
!/tools
# страница «Видео о продукции» — код (компонент в режиме сетки), не контент
!/video
# меню раздела /info/ — в нём ссылка на /video/; остальное в /info/ — контент
!/info
/info/*
!/info/.left.menu_ext.php
# правила обхода роботов: robots.php отдаёт aspro_regions/robots/robots_<хост>.txt,
# корневой robots.txt — резерв. Это настройка, а не контент: правится и на проде,
# поэтому версионируем, чтобы правки не терялись при выкладке
!/robots.txt
!/aspro_regions
/aspro_regions/*
!/aspro_regions/robots
/aspro_regions/robots/*
!/aspro_regions/robots/*.txt
# внутри local исключаем служебное
/local/**/*.log
/local/php_interface/dbconn.php
# боевой токен API коротких ссылок — вне Git, образец рядом в config.sample.php
/local/short-link/config.php
# боевой токен обмена остатков с 1С — вне Git, образец рядом в config.sample.php
/local/stock-sync/config.php
/local/stock-sync/logs/

# зависимости скриптов в /tools
/tools/**/node_modules
/tools/**/package-lock.json
