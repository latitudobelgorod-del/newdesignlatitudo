# Версионируем ТОЛЬКО свой код в /local. Всё остальное (ядро Битрикса, контент,
# upload, дампы, мусор, окружение) — вне Git.
/*
!/.gitignore
!/local
# документация и скрипт запуска — общие для всех машин, их версионируем
!/WORKFLOW.md
!/CLAUDE.md
!/start-latitudo-ru.cmd
!/tools
# внутри local исключаем служебное
/local/**/*.log
/local/php_interface/dbconn.php
# боевой токен API коротких ссылок — вне Git, образец рядом в config.sample.php
/local/short-link/config.php
# боевой токен обмена остатков с 1С — вне Git, образец рядом в config.sample.php
/local/stock-sync/config.php
