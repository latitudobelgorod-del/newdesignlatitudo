# Stock Sync API — Apache rewrite rules
# For shared hosting with Apache

# Токен ЗДЕСЬ НЕ ДЕРЖИМ: этот файл в Git, а репозиторий публичный.
# Он лежит в config.php рядом (config.php вне Git).

RewriteEngine On
RewriteBase /local/stock-sync/

# Route all requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php [L,QSA]

# Deny access to config, mapping, and logs
<FilesMatch "\.(json|log)$">
    Require all denied
</FilesMatch>

<Files "config.php">
    Require all denied
</Files>

# Deny access to logs directory
<IfModule mod_rewrite.c>
    RewriteRule ^logs/ - [F,L]
</IfModule>
